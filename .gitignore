# Python
.venv/
__pycache__/
*.pyc

# cocotb / simulator build output
sim_build/
obj_dir/
results.xml
*.vcd
*.fst
*.vvp
*.log

# Synthesis and flow output
build/
flow/out/
# LibreLane writes one run directory per candidate, several gigabytes each. The
# configuration that produced it is committed; the run itself is reproducible output.
flow/librelane/*/runs/
*.json.gz

# Editors
.vscode/
.idea/
*.swp

# Yosys machine-readable netlists and full transcripts: build artefacts, not
# evidence. Only the trimmed reports under results/synth are committed.
results/synth/**/*.json.netlist
results/synth/**/*_yosys.log

# PDK checkout from tools/fetch_pdk.sh: a large third-party artefact with its own
# release cadence. Fetch it, do not vendor it. Anchored to the repository root on
# purpose: an unanchored pdk/ also matched results/pdk, which is where the real PDK
# measurements live, and quietly kept them out of the repository.
/pdk/
