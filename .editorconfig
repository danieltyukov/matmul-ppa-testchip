root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# SystemVerilog: two spaces, 88 columns. The comments in this repository carry a lot of
# reasoning and 80 was cramping it.
[*.{sv,svh,v,vh}]
indent_size = 2
max_line_length = 88

[*.py]
indent_size = 4
max_line_length = 88

[*.{tcl,sdc}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
